# ==============================================================================
# ERP CONSTRUCTION & MANUFACTURING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Lưu ý cho lập trình viên mới:
# 1. Copy file này thành file .env: cp .env.example .env
# 2. Không bao giờ commit file .env chứa mật khẩu thực tế lên GitHub!

# ------------------------------------------------------------------------------
# 1. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=erp_core_db
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=erp_secure_password_2026

# Connection string chuẩn cho .NET Backend
DEFAULT_CONNECTION_STRING=Host=localhost;Port=5434;Database=erp_core_db;Username=erp_admin;Password=erp_secure_password_2026;

# ------------------------------------------------------------------------------
# 2. REDIS DISTRIBUTED CACHE & LOCKING
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. RABBITMQ MESSAGE BROKER
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=erp_guest
RABBITMQ_DEFAULT_PASS=erp_guest_2026

# ------------------------------------------------------------------------------
# 4. BACKEND & SECURITY SETTINGS (.NET 8)
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
USE_IN_MEMORY_DB=false
JWT_SECRET_KEY=ERP_ENTERPRISE_SECRET_KEY_FOR_JWT_SECURITY_TOKENS_2026_CHANGE_IN_PROD
JWT_ISSUER=ErpSystem.Api
JWT_AUDIENCE=ErpSystem.Clients
JWT_EXPIRATION_MINUTES=480

# ------------------------------------------------------------------------------
# 5. FRONTEND SETTINGS (React + Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_TITLE="ERP Xây Dựng & Sản Xuất"
